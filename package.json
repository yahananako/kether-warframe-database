{
  "name": "kether-warframe-database",
  "version": "2.6.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/register-warframe-card-command.mjs --if-configured",
    "start": "next start",
    "data:kuva": "node scripts/generate-kuva-catalog.mjs",
    "data:warframes": "node scripts/generate-warframe-details.mjs",
    "data:android": "node android/scripts/build-v3-data.mjs && node android/scripts/build-search-data.mjs",
    "sheet:kuva": "node scripts/prepare-kuva-sheet-update.mjs",
    "test:kuva": "node scripts/test-kuva-sync.mjs",
    "test:warframes": "node scripts/test-warframe-details.mjs",
    "test:android-search": "node android/scripts/test-smart-search.mjs",
    "test:discord-bot": "node --import tsx scripts/test-discord-bot.ts",
    "discord:validate": "node scripts/register-warframe-card-command.mjs --dry-run",
    "discord:register-card": "node scripts/register-warframe-card-command.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "opencc-js": "^1.4.2",
    "tsx": "4.23.13",
    "typescript": "latest"
  }
}
